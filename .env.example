# Example environment variables for local development.
# Copy to .env and adjust as needed.

# PostgreSQL
POSTGRES_DB=perfuntracker
POSTGRES_USER=perfun
POSTGRES_PASSWORD=perfun_dev

# SMTP (MailHog in dev)
SMTP_HOST=mailhog
SMTP_PORT=1025

# ─── Production-only (used by docker-compose.prod.yml) ───

# Connection string for PostgreSQL (prod)
CONNECTION_STRING=Host=postgres;Port=5432;Database=perfuntracker;Username=perfun;Password=CHANGE_ME

# JWT signing key — Base64, min 256 bits. GENERATE A NEW ONE for prod:
#   openssl rand -base64 48
JWT_KEY=CHANGE_ME_TO_A_REAL_BASE64_KEY

# Domain for Caddy automatic TLS (Let's Encrypt)
DOMAIN=perfuntracker.example.com

# SMTP (real provider in prod)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@perfuntracker.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=noreply@perfuntracker.com
SMTP_FROM_NAME=PerFunTracker
